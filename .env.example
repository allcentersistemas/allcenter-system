# Coolify → Environment Variables
# IMPORTANTE: valores literales. Nunca pongas ${POSTGRES_HOST} dentro de otra variable.

SPRING_DATASOURCE_URL=jdbc:postgresql://HOST_O_UUID_COOLIFY:5432/app_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

BIESSE_DATASOURCE_URL=jdbc:postgresql://HOST_O_UUID_COOLIFY:5432/obras
BIESSE_DATASOURCE_USERNAME=postgres
BIESSE_DATASOURCE_PASSWORD=CHANGE_ME

# Opcional (si no las pones, se reutilizan las de BIESSE_*)
# BACKUP_BIESSE_DATASOURCE_URL=jdbc:postgresql://HOST_O_UUID_COOLIFY:5432/obras
# BACKUP_BIESSE_DATASOURCE_USERNAME=postgres
# BACKUP_BIESSE_DATASOURCE_PASSWORD=CHANGE_ME

JWT_SECRET=CHANGE_ME
APP_BIESSE_INTERNAL_TOKEN=CHANGE_ME

APP_CORS_ALLOWED_ORIGINS=https://portal.allcenter.pe,https://app.novocentronorte.com
SPRING_PROFILES_ACTIVE=prod
JPA_DDL_AUTO=update

APP_AUTH_FIRST_SETUP_ENABLED=true
APP_AUTH_REGISTRATION_ENABLED=false
MASTER_USER_BOOTSTRAP=false

APP_MAIL_ENABLED=false
APP_MAIL_FROM=noreply@allcenter.pe
APP_MAIL_FROM_NAME=AllCenter
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=true

APP_BACKUP_MAX_ATTACHMENT_MB=50
