# Variables locales / referencia. El despliegue de producción usa el .env
# de la raíz del monorepo appscanner (docker compose + Caddy).

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB_SYSTEM=app_db
POSTGRES_DB_BIESSE=obras

# openssl rand -base64 48
JWT_SECRET=CHANGE_ME
# openssl rand -hex 32  (mismo valor en ambos servicios; X-Internal-Token)
APP_BIESSE_INTERNAL_TOKEN=CHANGE_ME

APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

SPRING_PROFILES_ACTIVE=prod
JPA_DDL_AUTO=update

APP_AUTH_FIRST_SETUP_ENABLED=true
APP_AUTH_REGISTRATION_ENABLED=false
MASTER_USER_BOOTSTRAP=false

APP_MAIL_ENABLED=false
APP_MAIL_FROM=noreply@example.com
APP_MAIL_FROM_NAME=AllCenter
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=true

APP_BACKUP_MAX_ATTACHMENT_MB=50
