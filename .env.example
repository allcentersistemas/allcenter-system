# Variables para Coolify (Environment Variables) o `docker compose` local.
# En Coolify no hace falta este archivo: define las mismas keys en la UI.
# Obligatorio (Coolify las marca como required por ${VAR:?} en el compose):

SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/app_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

BIESSE_DATASOURCE_URL=jdbc:postgresql://HOST:5432/obras
BIESSE_DATASOURCE_USERNAME=postgres
BIESSE_DATASOURCE_PASSWORD=CHANGE_ME

# openssl rand -base64 48
JWT_SECRET=CHANGE_ME
# openssl rand -hex 32  (mismo valor en ambos servicios; X-Internal-Token)
APP_BIESSE_INTERNAL_TOKEN=CHANGE_ME

# Orígenes HTTPS de tus frontends (coma-separados)
APP_CORS_ALLOWED_ORIGINS=https://portal.example.com,https://app.example.com

SPRING_PROFILES_ACTIVE=prod
JPA_DDL_AUTO=update

APP_AUTH_FIRST_SETUP_ENABLED=true
APP_AUTH_REGISTRATION_ENABLED=false
MASTER_USER_BOOTSTRAP=false
# MASTER_USER_EMAIL=
# MASTER_USER_PASSWORD=
# FIRST_SETUP_SECRET=

# Mail (opcional)
APP_MAIL_ENABLED=false
APP_MAIL_FROM=noreply@example.com
APP_MAIL_FROM_NAME=AllCenter
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=true

# Backups (module-system): suele reutilizar la misma BD obras
BACKUP_BIESSE_DATASOURCE_URL=jdbc:postgresql://HOST:5432/obras
BACKUP_BIESSE_DATASOURCE_USERNAME=postgres
BACKUP_BIESSE_DATASOURCE_PASSWORD=CHANGE_ME
APP_BACKUP_MAX_ATTACHMENT_MB=50
