# Coolify → Environment Variables (o cp .env.example .env en local).
# Mismas keys que el stack de appscanner; el compose arma los JDBC solo.

POSTGRES_HOST=161.132.52.100
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB_SYSTEM=app_db
POSTGRES_DB_BIESSE=obras

# openssl rand -base64 48
JWT_SECRET=CHANGE_ME
# openssl rand -hex 32
APP_BIESSE_INTERNAL_TOKEN=CHANGE_ME

APP_CORS_ALLOWED_ORIGINS=https://portal.allcenter.pe,https://app.novocentronorte.com

SPRING_PROFILES_ACTIVE=prod
JPA_DDL_AUTO=update

APP_AUTH_FIRST_SETUP_ENABLED=true
APP_AUTH_REGISTRATION_ENABLED=false
MASTER_USER_BOOTSTRAP=false

APP_MAIL_ENABLED=false
APP_MAIL_FROM=noreply@allcenter.pe
APP_MAIL_FROM_NAME=AllCenter
SMTP_HOST=mail.novocentronorte.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

APP_BACKUP_MAX_ATTACHMENT_MB=50
